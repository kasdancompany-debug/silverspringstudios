# =============================================================================
# Copy to .env.local for development. Replace every .example / your-* value
# before production deploy. Production must never ship placeholder URLs/emails.
# =============================================================================

# Site (required in production — no .example hosts)
NEXT_PUBLIC_SITE_URL=https://silverspringstudios.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=silverspringfilms@gmail.com
# Optional public social handle; leave empty if unused
NEXT_PUBLIC_TWITTER_HANDLE=

# Supabase (required for auth, persistence, private uploads)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend) — free tier can send to your account email; verify a domain to email filmmakers
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Silver Spring Studios <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL=silverspringfilms@gmail.com

# Demo / sample data is allowed automatically in non-production when Supabase
# is missing. It is ALWAYS disabled in production (NODE_ENV=production),
# even if this flag is set to true.
NEXT_PUBLIC_DEMO_MODE=false
